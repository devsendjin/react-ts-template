{
  "name": "react-ts-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "format": "prettier --ignore-unknown --write \"src/**/*.{ts,tsx,json,scss,css}\" \"package.json\" \"*.{js,ts,html}\"",
    "lint:tsc": "tsc --noEmit --noUnusedParameters --noUnusedLocals -p tsconfig.app.json && tsc --noEmit --noUnusedParameters --noUnusedLocals -p tsconfig.node.json",
    "tsc:dev:watch": "tsc -p tsconfig.app.json --noEmit --watch"
  },
  "dependencies": {
    "axios": "1.19.0",
    "classnames": "2.5.1",
    "dayjs": "1.11.21",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "prettier": "3.9.6",
    "sass-embedded": "1.100.0",
    "typescript": "7.0.2",
    "vite": "8.2.0"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
